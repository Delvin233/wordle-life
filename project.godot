; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="wordleLife"
run/main_scene="uid://c4d0rtoq71ffa"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

Dialogic="*uid://ds2q0uclmolvu"

[dialogic]

directories/dch_directory={
"agent": "res://dialogs/characters/agent.dch"
}
directories/dtl_directory={
"actions_complete": "res://dialogs/timelines/actions_complete.dtl",
"alerts": "res://dialogs/timelines/alerts.dtl",
"biometrics": "res://dialogs/timelines/biometrics.dtl",
"choice_to_quit_or_play_again": "res://dialogs/timelines/choice_to_quit_or_play_again.dtl",
"credits": "res://dialogs/timelines/credits.dtl",
"failure": "res://dialogs/timelines/failure.dtl",
"fill_in_the_blanks": "res://dialogs/timelines/fill_in_the_blanks.dtl",
"intro_and_rules": "res://dialogs/timelines/intro_and_rules.dtl",
"pini": "res://dialogs/timelines/pini.dtl",
"privacy": "res://dialogs/timelines/privacy.dtl",
"success": "res://dialogs/timelines/success.dtl"
}
layout/style_directory={
"": "res://dialogs/styles/style_1.tres",
"style_1": "res://dialogs/styles/style_1.tres"
}
layout/style_list=["res://dialogs/styles/style_1.tres"]
layout/default_style="res://dialogs/styles/style_1.tres"
text/letter_speed=0.01
text/initial_text_reveal_skippable=true
text/text_reveal_skip_delay=0.1
text/advance_delay=0.1
text/autoadvance_per_character_delay=0.1
text/autoadvance_ignored_characters_enabled=true
save/autosave_delay=60.0
save/encryption_on_exports_only=true
animations/join_default_length=0.5
animations/join_default_wait=true
animations/leave_default_length=0.5
animations/leave_default_wait=true
animations/cross_fade_default_length=0.5
choices/autofocus_first=true
choices/delay=0.2
choices/reveal_delay=0
choices/reveal_by_input=false
text/autopauses={}
audio/channel_defaults={
"": {
"audio_bus": "",
"fade_length": 0.0,
"loop": false,
"volume": 0.0
},
"music": {
"audio_bus": "",
"fade_length": 0.0,
"loop": true,
"volume": 0.0
}
}

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="viewport"
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="wordleLife"

[editor_plugins]

enabled=PackedStringArray("res://addons/dialogic/plugin.cfg")

[file_customization]

folder_colors={
"res://assets/": "purple",
"res://scenes/": "yellow",
"res://scripts/": "red"
}

[input]

dialogic_default_action={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":16,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":4194309,"physical_keycode":0,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
